{
  "name": "quiz-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready real-time quiz platform (Kahoot-style)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "npm run build --workspace @quiz/shared",
    "build": "npm run build --workspace @quiz/shared && npm run build --workspace @quiz/api",
    "build:web": "npm run build --workspace @quiz/web",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --workspace @quiz/api\" \"API_PROXY_TARGET=http://localhost:3001 NEXT_PUBLIC_SOCKET_URL=http://localhost:3001 npm run dev --workspace @quiz/web\"",
    "dev:api": "npm run dev --workspace @quiz/api",
    "dev:web": "npm run dev --workspace @quiz/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @quiz/api",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.11.0",
    "prisma": "7.10.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "dotenv": "^18.0.3"
  }
}
