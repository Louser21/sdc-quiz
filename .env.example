# =============================================================================
# Quiz Platform - Environment Variables
# Copy to `.env` for local development. NEVER commit real `.env` files.
# All values shown are safe local-development defaults except SESSION_SECRET.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development                      # development | staging | production
LOG_LEVEL=info                            # pino log level

# --- Ports (host side) -------------------------------------------------------
API_PORT=3001                             # Fastify + Socket.IO backend
WEB_PORT=3000                             # Next.js frontend (dev)
NGINX_PORT=8080                           # single-origin reverse proxy (compose)
# NGINX_HTTP_PORT=80                      # prod ONLY: host port for nginx :80
#                                         # (443 is added by docker-compose.prod.yml)

# --- URLs --------------------------------------------------------------------
PUBLIC_URL=http://localhost:8080          # externally-visible base URL
FRONTEND_ORIGIN=http://localhost:8080     # CORS-allowed origin for the web app

# --- Database (PostgreSQL) ---------------------------------------------------
# Managed by docker-compose for local dev. Override for staging/production.
DATABASE_URL=postgresql://quiz:quiz@localhost:5432/quiz

# --- Redis -------------------------------------------------------------------
# Local dev can use an existing redis on the host, or the compose one (host port 6380).
REDIS_URL=redis://localhost:6379

# --- Auth / Sessions ---------------------------------------------------------
# 32+ random bytes; use `openssl rand -hex 32`.
SESSION_SECRET=change-me-change-me-change-me-change-me!!
SESSION_COOKIE_NAME=quiz_session
SESSION_TTL_DAYS=30                       # host auth session lifetime
HOST_GRACE_PERIOD_MS=120000               # game survives this long after host loss

# --- Scoring (server-authoritative fixed points) ------------------------------
# points = isCorrect ? SCORE_BASE : 0
SCORE_BASE=1000

# --- Default paper time limit -------------------------------------------------
DEFAULT_QUIZ_TIME_LIMIT_SECONDS=600          # seconds; applied to new quizzes

# --- Rate limiting (HTTP + per-IP; @fastify/rate-limit, in-memory store) -------
RATE_LIMIT_ENABLED=true                      # 0/false disables the plugin
RATE_LIMIT_GLOBAL_MINUTE=600                 # floor: any /api route per IP
RATE_LIMIT_LOGIN_MINUTE=30                   # POST /api/auth/login per IP
RATE_LIMIT_REGISTER_MINUTE=30                # POST /api/auth/register per IP
RATE_LIMIT_JOIN_MINUTE=120                   # POST /api/play/join per IP

# --- Observability -------------------------------------------------------------
# Prometheus text metrics are exposed at GET /api/metrics (no auth, ops-only use).